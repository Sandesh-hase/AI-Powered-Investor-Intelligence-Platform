      ],
      "updated": 1780378345858,
      "link": null,
      "locked": false,
      "text": "Paragraph 1:\nTesla revenue increased by 12%.\n\nParagraph 2:\nThe increase was driven by energy storage sales.\n\nParagraph 3:\nOperating margin improved significantly.\n\nParagraph 4:\nRisk Factors\n\nParagraph 5:\nSupply chain disruptions may impact future growth.\n\nParagraph 6:\nChanges in regulations could affect profitability.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Paragraph 1:\nTesla revenue increased by 12%.\n\nParagraph 2:\nThe increase was driven by energy storage sales.\n\nParagraph 3:\nOperating margin improved significantly.\n\nParagraph 4:\nRisk Factors\n\nParagraph 5:\nSupply chain disruptions may impact future growth.\n\nParagraph 6:\nChanges in regulations could affect profitability.",
      "autoResize": false,
      "lineHeight": 1.25
